{
  // provider, model và cường độ suy luận (reasoning effort) mặc định được sử dụng.
  // ★ Giá trị của provider là một tên key trong phần providers bên dưới (một "con trỏ"), không phải là tên giao thức——
  //   Việc thay đổi provider phải đảm bảo có một mục nhập cùng tên trong providers, nếu không khi khởi động sẽ báo "chưa cấu hình thông tin xác thực" (未配置凭证).
  //   Lúc chạy, hãy sử dụng /config để quản lý thư viện Provider/model, và dùng /model để chuyển đổi giữa các model đã lưu.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Tùy chọn. Cường độ suy luận mặc định: off / low / medium / high / xhigh / max.
  // Bỏ qua hoặc chuỗi rỗng = không ghi đè, kế thừa mặc định của model/provider.
  "reasoning_effort": "medium",

  // Thư viện thông tin xác thực Provider. Key tự định nghĩa, được dùng làm mục tiêu cho trường provider tham chiếu ở trên.
  // Các provider đã biết (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // có thể bỏ qua type; proxy tùy chỉnh phải khai báo rõ ràng type để chỉ định giao thức API.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai báo các ứng cử viên bảng /model và cửa sổ ngữ cảnh độc quyền của model; chuỗi mảng cũ vẫn tương thích.
      // json_schema là sự ghi đè rõ ràng cho đầu ra có cấu trúc nguyên bản: true=xác nhận hỗ trợ, false=xác nhận không hỗ trợ,
      // Bỏ qua=sử dụng khả năng của adapter. Đối với proxy trung gian tùy chỉnh hoặc khi khả năng phụ thuộc vào model cụ thể, nên điền rõ ràng.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Truyền thêm các tham số bổ sung cho mỗi yêu cầu của provider này (các tham số lấy mẫu như temperature/top_p/
      // min_p, hoặc các key cụ thể của nhà cung cấp như chat_template_kwargs của nvidia khi bật think), được gộp nguyên văn vào body yêu cầu.
      // Chỉ có hiệu lực với các provider tương thích với OpenAI (openrouter/deepseek/qwen/glm/grok/ollama…);
      // type:"openai" sẽ lọc theo danh sách trắng (whitelist) các tham số chính thức. Giá trị do người dùng tự chịu trách nhiệm.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp provider, truyền cho lớp HTTP client (không phải body yêu cầu), dùng cho các proxy
      // cần tùy chỉnh User-Agent / headers / anthropic_beta.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4-6", "json_schema": true }]
    },
    "ollama": {
      // ollama / bedrock / các proxy tùy chỉnh có type rõ ràng có thể bỏ qua api_key
      // base_url cần chứa /v1 (endpoint tương thích OpenAI của ollama nằm dưới /v1)
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Tùy chọn. Watchdog giới hạn thời gian rảnh luồng stream (Go duration, mặc định "5m"): Đối với suy luận chậm cục bộ như LocalAI/ollama,
      // khối (block) đầu tiên có thể vượt quá 5 phút, được nới lỏng theo provider, không ảnh hưởng đến các kênh khác.
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Proxy Anthropic tùy chỉnh. Nếu thượng nguồn hạn chế chỉ có thể truy cập bởi client Claude Code,
      // hãy sử dụng extra để truyền user_agent / anthropic_beta / headers.
      // base_url không cần chứa /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Proxy OpenAI/NewAPI tùy chỉnh. Nếu thượng nguồn hạn chế chỉ có thể truy cập bởi client Codex,
      // hãy sử dụng extra để ghi đè User-Agent, và truyền header định danh Codex.
      // base_url điền theo địa chỉ thực tế của proxy; Giao thức OpenAI thường cần /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000, "json_schema": true },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Tùy chọn. Endpoint giao thức OpenAI: chat (mặc định /v1/chat/completions) /
      // responses (/v1/responses). Các proxy loại Codex thường cần responses.
      "api": "responses",
      "extra": {
        // Tùy chọn. Key định tuyến bộ nhớ đệm (cache) prompt_cache_key theo mặc định chỉ gửi đến api.openai.com chính thức——
        // Các endpoint tương thích của bên thứ ba không có hợp đồng thống nhất đối với các trường không xác định (các bên kiểm tra nghiêm ngặt như Groq/Cerebras/Huoshan sẽ trả về 400,
        // kiểu proxy biên dịch lại sẽ âm thầm loại bỏ). Khi xác nhận rằng máy chủ trung gian của bạn truyền nguyên văn body yêu cầu đến OpenAI,
        // bật mục này có thể có được sự gắn kết định tuyến bộ nhớ đệm (cải thiện tỷ lệ trúng).
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Tùy chọn. Ghi đè model mặc định theo vai trò (role); các vai trò không được cấu hình sẽ sử dụng model bên trên.
  // reasoning_effort cũng có thể được ghi đè theo vai trò; khi không được cấu hình, nó sẽ kế thừa reasoning_effort ở cấp cao nhất.
  // Vai trò: architect / writer / editor. fallbacks sẽ được thử theo thứ tự khi model chính gặp lỗi.
  // Lưu ý: provider ở đây cũng là một "con trỏ", phải trỏ đến một key tồn tại trong providers.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Văn phong sáng tác: default / suspense / fantasy / romance.
  "style": "default"

  // Cửa sổ ngữ cảnh (context window) toàn cục phiên bản cũ, được giữ lại làm giá trị dự phòng cho tất cả các model. Ưu tiên thấp hơn models[].context_window,
  // cao hơn registry model và giá trị mặc định 200k. Chỉ ảnh hưởng đến ngưỡng nén, không thay đổi độ dài yêu cầu thực tế của API.
  // "context_window": 300000

  // Tùy chọn. Ngân sách chi phí cho một cuốn sách duy nhất (thư mục output), cầu chì dự phòng khi treo máy. Chỉ kích hoạt khi book_usd > 0.
  // Khi chi phí tích lũy đạt warn_ratio sẽ cảnh báo nhưng không dừng máy; khi đạt 100% sẽ
  // dừng máy một cách nhẹ nhàng (graceful) sau khi tác vụ subagent hiện tại kết thúc (nếu hard_stop=true thì dừng ngay lập tức khi vượt giới hạn). Sau khi dừng máy, việc tăng book_usd có thể khôi phục việc chạy tiếp.
  // Lưu ý: Nếu model tùy chỉnh không tra cứu được giá trong registry và provider không tự báo cáo chi phí, thì ngân sách này không có tác dụng.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Tùy chọn. Cảnh báo khi không có người giám sát, mặc định được kích hoạt (thông báo Windows / macOS osascript / Linux notify-send).
  // Sau khi cấu hình command, nó sẽ chạy lệnh tùy chỉnh (thông báo đẩy trên điện thoại di động chạy qua đây): Các trường thông qua biến môi trường
  // NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND / NOTIFY_LEVEL được truyền qua, JSON hoàn chỉnh đồng thời được ghi vào stdin.
  // Unix shell dùng $NOTIFY_TITLE; Windows PowerShell dùng $env:NOTIFY_TITLE.
  // Lọc tùy chọn events: run_end / budget / advance_gate / stop_guard /
  // plan_start / deadlock / worker_failure; mặc định kích hoạt tất cả.
  // "notify": {
  //   "enabled": true,
  //   // Tiêu đề/Nội dung có chứa tiếng Trung và khoảng trắng, phải truyền tham số qua --data-urlencode, không thể nối vào đường dẫn URL hoặc header HTTP.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }
}
