{
  // Provider, model và độ nỗ lực suy luận mặc định.
  // ★ Giá trị của provider là một tên key trong mục providers bên dưới (một "con trỏ"), không phải tên giao thức —
  //   Đổi provider bắt buộc phải đảm bảo trong providers có mục cùng tên, nếu không khởi động sẽ báo "chưa cấu hình thông tin xác thực".
  //   Khi chạy dùng /config để quản lý kho Provider/Model, dùng /model để chuyển đổi giữa các model đã lưu.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Tùy chọn. Độ nỗ lực suy luận mặc định: off / low / medium / high / xhigh / max.
  // Bỏ qua hoặc chuỗi rỗng = không ghi đè, dùng mặc định của model/provider.
  "reasoning_effort": "medium",

  // Kho thông tin xác thực Provider. key tùy chỉnh, dùng làm mục tiêu tham chiếu của trường provider ở trên.
  // Các provider đã biết (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // có thể bỏ qua type; proxy tùy chỉnh bắt buộc phải khai báo rõ type để chỉ định giao thức API.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai báo danh sách ứng viên bảng điều khiển /model và cửa sổ ngữ cảnh riêng của model; mảng chuỗi kiểu cũ vẫn tương thích.
      // json_schema là ghi đè rõ ràng cho đầu ra cấu trúc native: true=xác nhận hỗ trợ, false=xác nhận không hỗ trợ,
      // bỏ qua=dùng khả năng của adapter. Nên điền rõ khi dùng trung chuyển tùy chỉnh hoặc khả năng phụ thuộc vào model cụ thể.
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Tham số bổ sung truyền thẳng cho mỗi yêu cầu của provider này (tham số lấy mẫu như temperature/top_p/
      // min_p, hoặc key đặc thù của hãng như nvidia bật think chat_template_kwargs), gộp nguyên văn vào body yêu cầu.
      // Chỉ có hiệu lực với các provider tương thích OpenAI (openrouter/deepseek/qwen/glm/grok/ollama…);
      // type:"openai" sẽ lọc theo danh sách trắng tham số chính thức. Người dùng tự chịu trách nhiệm về giá trị.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp provider, truyền thẳng xuống tầng HTTP client (không phải body yêu cầu), dùng cho
      // proxy cần tùy chỉnh User-Agent / headers / anthropic_beta.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4-6", "json_schema": true }]
    },
    "ollama": {
      // ollama / bedrock / proxy tùy chỉnh có type rõ ràng có thể bỏ qua api_key
      // base_url cần kèm /v1 (endpoint tương thích OpenAI của ollama nằm dưới /v1)
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Tùy chọn. Watchdog rảnh luồng stream (Go duration, mặc định "5m"): LocalAI/ollama v.v.
      // suy luận chậm cục bộ chunk đầu có thể quá 5 phút, nới lỏng theo provider, không ảnh hưởng kênh khác
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Proxy Anthropic tùy chỉnh. Nếu upstream giới hạn chỉ cho phép client Claude Code truy cập,
      // dùng extra để truyền user_agent / anthropic_beta / headers.
      // base_url không cần kèm /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Proxy OpenAI/NewAPI tùy chỉnh. Nếu upstream giới hạn chỉ cho phép client Codex truy cập,
      // dùng extra để ghi đè User-Agent và truyền header nhận diện Codex.
      // base_url điền theo địa chỉ thực tế của proxy; giao thức OpenAI thường cần /v1.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000, "json_schema": true },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Tùy chọn. Endpoint giao thức OpenAI: chat (mặc định /v1/chat/completions) /
      // responses (/v1/responses). Proxy kiểu Codex thường cần responses.
      "api": "responses",
      "extra": {
        // Tùy chọn. Key định tuyến cache prompt_cache_key mặc định chỉ gửi cho api.openai.com chính thức —
        // các endpoint tương thích bên thứ ba không có hợp đồng thống nhất cho trường chưa biết (Groq/Cerebras/Volcengine nghiêm ngặt sẽ 400,
        // trung chuyển gom nhóm sẽ âm thầm bỏ rơi). Khi xác nhận trung chuyển của bạn chuyển tiếp nguyên văn body sang OpenAI,
        // bật mục này có thể nhận được định tuyến cache tối ưu (tăng tỷ lệ hit cache).
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Tùy chọn. Ghi đè model mặc định theo vai trò; vai trò chưa cấu hình dùng model ở trên.
  // reasoning_effort cũng có thể ghi đè theo vai trò; khi chưa cấu hình sẽ kế thừa reasoning_effort tầng cao nhất.
  // Vai trò: architect / writer / editor. fallbacks sẽ thử lần lượt khi model chính thất bại.
  // Chú ý: provider ở đây cũng là "con trỏ", bắt buộc phải trỏ đến key tồn tại trong providers.
  // "roles": {
  //   "writer": {
  //     "provider": "anthropic",
  //     "model": "claude-sonnet-4",
  //     "reasoning_effort": "high",
  //     "fallbacks": [{ "provider": "openrouter", "model": "google/gemini-3.0-pro" }]
  //   },
  //   "architect": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Phong cách viết: default / suspense / fantasy / romance.
  "style": "default"

  // Cửa sổ ngữ cảnh toàn cục kiểu cũ, giữ làm dự phòng cho mọi model. Mức ưu tiên thấp hơn models[].context_window,
  // cao hơn sổ đăng ký model và giá trị mặc định 200k. Chỉ ảnh hưởng ngưỡng nén, không thay đổi độ dài yêu cầu API thực tế.
  // "context_window": 300000

  // Tùy chọn. Ngân sách chi phí cho một cuốn sách (thư mục output), cầu chì chạy tự động. Chỉ kích hoạt khi book_usd > 0.
  // Chi phí tích lũy đạt warn_ratio sẽ cảnh báo nhưng không dừng máy; đạt 100% sẽ dừng máy nhẹ nhàng sau khi tác vụ subagent hiện tại kết thúc
  // (nếu hard_stop=true sẽ dừng ngay khi vượt ranh giới). Sau khi dừng máy chỉ cần tăng book_usd là có thể tiếp tục chạy.
  // Chú ý: Model tùy chỉnh nếu sổ đăng ký không tra được giá và provider không tự báo cost thì ngân sách coi như vô hiệu.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Tùy chọn. Cảnh báo khi chạy không người giám sát, mặc định bật (thông báo Windows / macOS osascript / Linux notify-send).
  // Sau khi cấu hình command sẽ chuyển sang chạy lệnh tùy chỉnh (đẩy thông báo điện thoại đi qua đây): các trường qua biến môi trường
  // NOTIFY_TITLE / NOTIFY_BODY / NOTIFY_KIND / NOTIFY_LEVEL được truyền vào, JSON đầy đủ đồng thời ghi vào stdin.
  // Unix shell dùng $NOTIFY_TITLE; Windows PowerShell dùng $env:NOTIFY_TITLE.
  // Lọc sự kiện tùy chọn trong events: run_end / budget / advance_gate / stop_guard /
  // plan_start / deadlock / worker_failure; mặc định bật tất cả.
  // "notify": {
  //   "enabled": true,
  //   // Tiêu đề/nội dung chứa tiếng Việt và dấu cách, bắt buộc phải truyền tham số qua --data-urlencode, không ghép vào đường dẫn URL hoặc HTTP header.
  //   // Bark (iOS):         "command": "curl -s --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"body=$NOTIFY_BODY\" https://api.day.app/<key>"
  //   // ntfy (iOS/Android): "command": "curl -s -G --data-urlencode \"title=$NOTIFY_TITLE\" --data-urlencode \"message=$NOTIFY_BODY\" ntfy.sh/<topic>/publish"
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }

  // Tùy chọn. Đặt true để tắt nhắc nhở kiểm tra phiên bản mới khi khởi động (mặc định bật). Kiểm tra chỉ đọc GitHub Releases
  // API công khai, kết quả cache cục bộ 24h; khi phát hiện phiên bản mới sẽ hiển thị số phiên bản và tóm tắt cập nhật trên trang chào / luồng sự kiện,
  // việc nâng cấp hay không luôn do bạn chạy ainovel-cli update quyết định.
  // "disable_update_check": false
}
